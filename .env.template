# .env
API_PORT=
# --- POSTGRES CONFIG (Para Docker y App) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# opcional si usas DB_HOST y DB_PORT, pero recomendado para despliegue en la nube
# DATABASE_URL=

# El HOST cambia según dónde corra el código:
# Si corres FastAPI local (fuera de docker): localhost
# Si corres FastAPI en un contenedor: db-postgres
DB_HOST= 

# --- PGADMIN CONFIG ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=
# DB RASH 
DB_RASH_USER=
DB_RASH_PASSWORD=
DB_RASH_HOST=
DB_RASH_DB=
DB_RASH_PORT=

# --- APP SECURITY ---
JWT_SECRET=
JWT_ALG=
JWT_EXPIRES_MIN=
AUDIT_ANALYTICS_REQUESTS=false

ENV=
PROJECT_NAME=
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=
