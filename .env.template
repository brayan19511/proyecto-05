JWT_SECRET=
JWT_ALG=
JWT_EXPIRES_MIN=

ENV=
PROJECT_NAME=
BACKEND_CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false

# --- AUDITORIA: QUE SE ENMASCARA EN LOS DETALLES ---
# Palabras que marcan un campo como credencial. Coincidencia por substring y
# sin tildes: "password" ya cubre new_password / current_password /
# passwordConfirm, y "contrasena" cubre "contrasena" con tilde.
# Es lo unico que se enmascara: todo lo demas se guarda tal cual.
# Vacio = no se enmascara nada (no recomendado).
AUDIT_SENSITIVE_KEYS=password,contrasena,token,secret,api_key,apikey,credential

# Cabeceras que se enmascaran completas (coincidencia exacta, no substring).
AUDIT_SENSITIVE_HEADERS=authorization,cookie,set-cookie,x-api-key

# Campos que se omiten por tamano, no por ser sensibles (adjuntos base64).
AUDIT_FILE_CONTENT_KEYS=file_base64,base64,content_base64,file_content

# Prefijos de ruta cuyo cuerpo de respuesta NO se guarda. Vacio = se guarda
# el cuerpo de todas las rutas. Ej: /api/sap,/api/jobs
AUDIT_REDACT_RESPONSE_PATHS=

# Tope en bytes del cuerpo de respuesta guardado. Arriba de esto se registra
# solo el tamano.
AUDIT_MAX_RESPONSE_BODY_BYTES=65536

# =====================================================
# MODULOS APAGADOS POR ENTORNO
# =====================================================
# Codigos separados por coma. Apagado duro: el panel no los puede prender.
# Usar solo para ambientes que no tienen credenciales/red del modulo.
# Codigos validos: sap, email, payment_provider, ledger, provisions,
# sales_channel, attendance, analytics, icg_query
MODULES_DISABLED=

# =====================================================
# ARCHIVO Y LIMPIEZA DE CONSTANCIAS DE PAGO
# =====================================================
# Archivo permanente de las constancias enviadas. Dejar VACIO: se usa la
# subcarpeta "archive" del staging, en el mismo volumen, para que mover el PDF
# sea un rename atomico y no haga falta declarar otro volumen. Solo llenarlo
# si algun dia el archivo va a otro disco.
PAYMENT_PROVIDER_ARCHIVE_DIR=
# Dias que se conserva el staging tras terminar el job (ventana de reintento).
PAYMENT_PROVIDER_RETENTION_DAYS=7
# Tope absoluto de vida del staging, sin importar el estado del job.
PAYMENT_PROVIDER_STAGING_MAX_AGE_DAYS=30
