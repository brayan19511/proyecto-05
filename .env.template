# .env
API_PORT=
BACKEND_IMAGE=brayan1951/backend-finance:v2.1.0
# --- POSTGRES CONFIG (Para Docker y App) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=
# opcional si usas DB_HOST y DB_PORT, pero recomendado para despliegue en la nube
# DATABASE_URL=

# El HOST cambia según dónde corra el código:
# Si corres FastAPI local (fuera de docker): localhost
# Si corres FastAPI en un contenedor: db-postgres
DB_HOST= 

# --- PGADMIN CONFIG ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# SAP DATABASE CONFIG
DB_SAP_USER=
DB_SAP_PASSWORD=
DB_SAP_HOST=
DB_SAP_PORT=

SAP_URL=
SAP_JOB_BATCH_SIZE=200
SAP_JOB_MAX_DOCUMENTS=50000
SAP_JOB_SOFT_TIME_LIMIT=3600
SAP_JOB_TIME_LIMIT=3900

# --- BACKGROUND JOBS / RABBITMQ ---
RABBITMQ_DEFAULT_USER=finance
RABBITMQ_DEFAULT_PASS=
RABBITMQ_MANAGEMENT_PORT=15672
# En Docker el host es rabbitmq. Codifica caracteres especiales del password.
CELERY_BROKER_URL=amqp://finance:password@rabbitmq:5672//
# Opcional. Si queda vacio se deriva de JWT_SECRET.
JOB_CREDENTIALS_KEY=

# --- SMTP / EMAIL ---
# Servidor SMTP tecnico. La plantilla define el "mail_from" visible si aplica.
SMTP_HOST=192.168.30.199
SMTP_PORT=25
SMTP_USER=no-reply@coolbox.com.pe
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@coolbox.com.pe
SMTP_FROM_NAME=Coolbox
SMTP_USE_TLS=false
EMAIL_TEMPLATE_DIR=app/templates/emails
PAYMENT_PROVIDER_STORAGE_DIR=/app/var/payment-provider-jobs

# OFISIS / SQL SERVER
DB_OFISIS_HOST=
DB_OFISIS_PORT=1433
DB_OFISIS_USER=
DB_OFISIS_PASSWORD=
DB_OFISIS_DRIVER=ODBC Driver 17 for SQL Server
DB_OFISIS_ENCRYPT=false
DB_OFISIS_TRUST_SERVER_CERTIFICATE=false
DB_OFISIS_ECOMM_DATABASE=EcommDB


DB_CIC_USER=
DB_CIC_PASSWORD=
DB_CIC_HOST=
DB_CIC_PORT=1433
DB_CIC_DRIVER=ODBC Driver 17 for SQL Server
DB_CIC_ENCRYPT=false
DB_CIC_TRUST_SERVER_CERTIFICATE=false
DB_CIC_DATABASE=dbcoolbox



# --- APP SECURITY ---
JWT_SECRET=
JWT_ALG=
JWT_EXPIRES_MIN=

ENV=
PROJECT_NAME=
BACKEND_CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false
